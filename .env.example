# Public Supabase project coordinates. The anon key is intentionally public and is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_ and never use from client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
